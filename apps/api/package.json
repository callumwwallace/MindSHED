{
  "name": "@mindshed/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.cjs",
    "test": "tsx --test src/*.unit.test.ts src/pilot-contract.test.ts",
    "test:integration": "tsx --test src/pilot-flow.integration.test.ts",
    "test:http": "tsx --test src/pilot-http.integration.test.ts",
    "test:lifecycle": "tsx --test src/data-lifecycle.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate-entry.ts",
    "db:seed:pilot": "tsx src/scripts/seed-pilot-code-entry.ts",
    "db:lifecycle": "tsx src/scripts/data-lifecycle-entry.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1108.0",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@mindshed/shared": "*",
    "@trpc/server": "^11.19.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "postgres": "^3.4.9",
    "superjson": "^2.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@trpc/client": "^11.19.0",
    "@types/node": "^22.20.1",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
